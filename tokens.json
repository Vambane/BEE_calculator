{
  "meta": {
    "name": "Klim",
    "version": "2.0-web",
    "note": "Tokens for the Klim web app. They match DESIGN.md and web/src/app.css (Geist, zinc neutrals, deep green accent). The Streamlit app and the WeasyPrint report keep the older honey theme in .streamlit/config.toml, app.py, report/tokens.css and report/report.css. Those files are not generated from this document."
  },
  "color": {
    "canvas": {"value": "#fafafa", "use": "Page background (zinc-50)"},
    "rail": {"value": "#f4f4f5", "use": "Step rail (zinc-100)"},
    "surface": {"value": "#ffffff", "use": "Cards, top bar, inputs"},
    "surface-2": {"value": "#fafafa", "use": "Secondary fill"},
    "line": {"value": "#e4e4e7", "use": "Hairline borders"},
    "line-strong": {"value": "#d4d4d8", "use": "Stronger borders, hover"},
    "ink": {"value": "#09090b", "use": "Primary text"},
    "ink-2": {"value": "#3f3f46", "use": "Secondary text"},
    "ink-3": {"value": "#71717a", "use": "Hints, captions"},
    "primary": {"value": "#18181b", "use": "Primary buttons, current-step disc"},
    "primary-hover": {"value": "#27272a"},
    "primary-active": {"value": "#09090b"},
    "accent": {
      "value": "#166534",
      "use": "Links, focus, selection, progress fills. 7.130:1 on #ffffff, 6.831:1 on #fafafa, 6.487:1 on #f4f4f5."
    },
    "accent-hover": {"value": "#14532d", "use": "Link hover. 9.111:1 on #ffffff."},
    "accent-soft": {"value": "#166534", "use": "Focus outline, same green as accent so the ring stays above 3:1"},
    "accent-tint": {"value": "#f3faf6", "use": "Selection and achieved wash. Accent text on it is 6.728:1."},
    "accent-tint-2": {"value": "#d7eee3", "use": "Stronger wash, level-ladder fill. Accent text on it is 5.850:1."},
    "success": {"value": "#15803d", "use": "Success state text. 5.016:1 on #ffffff. Distinct from the accent."},
    "warning": {"value": "#a16207"},
    "danger": {"value": "#b91c1c"},
    "info": {"value": "#1d4ed8"},
    "focus": {"value": "0 0 0 2px #ffffff, 0 0 0 4px #166534", "use": "Focus ring. Green stroke is 7.130:1 on white."}
  },
  "font": {
    "family": {
      "value": "\"Geist Variable\", \"Geist\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "hosting": "Self-hosted via the @fontsource-variable/geist package already in web/. No extra CDN."
    },
    "numeric": {"value": "tabular-nums / font-feature-settings: \"tnum\" 1"}
  },
  "type-scale": {
    "xs": "0.8125rem",
    "sm": "0.875rem",
    "md": "0.9375rem",
    "lg": "1.125rem",
    "xl": "1.375rem",
    "2xl": "2rem",
    "3xl": "3rem"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "20px",
    "xl": "28px"
  },
  "radius": {"sm": "10px", "md": "16px", "lg": "24px"},
  "shadow": {
    "rest": "0 1px 2px rgb(9 9 11 / 0.04), 0 1px 3px rgb(9 9 11 / 0.05)",
    "raised": "0 4px 12px -2px rgb(9 9 11 / 0.06), 0 2px 4px -2px rgb(9 9 11 / 0.04)",
    "pop": "0 16px 32px -8px rgb(9 9 11 / 0.14), 0 4px 8px -4px rgb(9 9 11 / 0.06)"
  },
  "breakpoint": {
    "phone": "360-430px results stack to one column",
    "narrow": "640px",
    "rail": "900px, step rail becomes a dialog"
  },
  "layout": {
    "topbar": "60px",
    "rail": "264px",
    "content-max": "880px",
    "results-max": "1040px",
    "tap-target-min": "44px"
  }
}
