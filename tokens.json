{
    "color": {
        "ink": {"value": "#1A1A1A", "use": "Primary text, headings"},
        "ink-muted": {"value": "#4A4A4A", "use": "Secondary text"},
        "ink-subtle": {"value": "#6B6B6B", "use": "Hints, captions (AA on paper at 14px+)"},
        "paper": {"value": "#FAF7F0", "use": "Page background (warm off-white)"},
        "surface": {"value": "#FFFFFF", "use": "Cards, inputs"},
        "line": {"value": "#E0D9C8", "use": "Borders, dividers"},
        "line-strong": {"value": "#B9B2A2", "use": "Input borders"},
        "primary": {"value": "#D4A017", "use": "Primary buttons, achieved bar fill, links"},
        "primary-hover": {"value": "#B8860B"},
        "primary-tint": {"value": "rgba(212, 160, 23, 0.12)", "use": "Selected step, info panels"},
        "accent": {"value": "#D4A017", "use": "Gap / points-available highlight (ochre)"},
        "accent-tint": {"value": "#F7ECD9"},
        "success": {"value": "#2E7D4F"},
        "warning": {"value": "#A15C07"},
        "danger": {"value": "#B3261E"},
        "danger-tint": {"value": "#FBE9E7"},
        "focus": {"value": "#D4A017", "use": "Focus ring (3px)"},
        "paper-2": {"value": "#F3EDE0", "use": "Sidebar / secondary background"},
    },
    "font": {
        "heading": {
            "value": '"SourceSerif4", Georgia, "Times New Roman", serif',
            "file": "SourceSerif4-Variable.ttf",
            "weights": "200-900",
        },
        "body": {
            "value": '"IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
            "file": "IBMPlexSans-Variable.ttf",
            "weights": "100-700",
        },
        "numeric": {
            "value": '"IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace',
            "file": "IBMPlexMono-Medium.ttf",
            "weights": "500",
        },
        "$hosting": "Self-hosted only, no Google Fonts CDN (POPIA). Source files in design/streamlit/static/fonts/ (SIL OFL). Streamlit: [[theme.fontFaces]] url app/static/fonts/... with server.enableStaticServing=true. Family 'SourceSerif4' has no spaces because Streamlit 1.66 dropped the face when the family was 'Source Serif 4'. WeasyPrint: @font-face with file paths in pdf/report.css. Next.js phase 2: next/font/local or @font-face from public/fonts.",
    },
    "type-scale": {
        "xs": "0.8125rem/1.4",
        "sm": "0.875rem/1.45",
        "base": "1rem/1.55",
        "lg": "1.125rem/1.5",
        "xl": "1.375rem/1.3",
        "2xl": "1.75rem/1.2",
        "3xl": "2.25rem/1.1",
        "display": "3.5rem/1",
    },
    "space": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "24px",
        "6": "32px",
        "7": "48px",
        "8": "64px",
    },
    "radius": {"sm": "4px", "md": "8px", "lg": "12px"},
    "shadow": {"card": "0 1px 2px rgba(26,26,26,.06)"},
    "breakpoint": {
        "sm": "0-599px (base, mobile-first)",
        "md": "600px",
        "lg": "960px",
        "xl": "1280px",
    },
    "layout": {"content-max": "1120px", "form-max": "560px", "tap-target-min": "48px"},
    "$meta": {
        "version": "1.3-honey",
        "note": "Honey visual language for BEE Calculator (honey-visual-pass-bee-calculator.md). Not a honey shop. Consumers: .streamlit/config.toml, app.py Plotly, report/report.css.",
        "streamlit-mapping": {
            "primaryColor": "color.primary",
            "backgroundColor": "color.paper",
            "secondaryBackgroundColor": "color.paper-2",
            "textColor": "color.ink",
            "font": "font.body",
            "headingFont": "font.heading",
            "codeFont": "font.numeric",
            "borderColor": "color.line",
            "sidebar.backgroundColor": "color.paper-2",
        },
        "plotly-mapping": {
            "achieved": "color.ink",
            "available-fill": "color.accent-tint",
            "available-pattern": "color.accent",
            "track": "color.paper-2",
            "grid": "color.line",
            "font": "font.body",
        },
    },
    "meta": {},
    "version": "1.3-honey",
    "note": "Honey visual language applied to BEE Calculator (see honey-visual-pass-bee-calculator.md). Not a honey shop.",
}
